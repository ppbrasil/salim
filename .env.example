# Copie para .env e preencha. NUNCA commite o .env.

# --- Login (obrigatório). Gere os dois valores com:  docker compose run --rm salim python -m salim.passwd
SALIM_USER=pedro
SALIM_PASSWORD_HASH=
SALIM_SECRET_KEY=
# Token opcional para scripts (Authorization: Bearer ...). Deixe vazio para desligar.
SALIM_API_TOKEN=
# Em HTTPS deixe 1. Só use 0 para testar em http://127.0.0.1:8000
SALIM_COOKIE_SECURE=1

# --- HTTPS (perfil https): domínio que aponta para este servidor
SALIM_DOMAIN=salim.seudominio.com.br

# --- Telegram (opcional). O segredo é obrigatório quando há token.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_IDS=
TELEGRAM_WEBHOOK_SECRET=

# --- WhatsApp Cloud API (opcional)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ALLOWED_NUMBERS=
